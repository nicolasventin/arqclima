DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://arqclima:arqclima@localhost:5432/arqclima

# Correo saliente. En desarrollo puede dejarse console; en producción usar smtp.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=compras@example.com
DJANGO_EMAIL_HOST_PASSWORD=cambiar-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=20
ARQCLIMA_EMAIL_FROM="ARQCLIMA <compras@example.com>"

# Datos que aparecen en la orden de compra PDF (opcionales salvo nombre/tagline).
ARQCLIMA_NOMBRE=ARQCLIMA
ARQCLIMA_TAGLINE=climatizando arquitectura
ARQCLIMA_RAZON_SOCIAL=
ARQCLIMA_CUIT=
ARQCLIMA_DIRECCION=
ARQCLIMA_TELEFONO=
ARQCLIMA_EMAIL=

# Importaciones asistidas por IA (apps.imports). Sin esta key, esos caminos
# fallan igual que un archivo que no se pudo analizar — no bloquean el resto
# del sistema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
